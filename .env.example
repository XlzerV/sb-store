# Supabase Postgres (production)
# Project Settings -> Database -> Connection string -> Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Supabase (Project Settings -> API)
SUPABASE_URL=https://REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...  # or service_role key
SUPABASE_STORAGE_BUCKET=products

# Auth
JWT_SECRET=change-me

# Yalidine / Ecomdz
ECOMDZ_API_KEY=
