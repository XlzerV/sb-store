{
  "name": "sb-store",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "start": "tsx server/index.ts",
    "init": "tsx scripts/init.ts",
    "export-data": "tsx scripts/export-data.ts",
    "migrate-uploads": "tsx scripts/migrate-uploads.ts",
    "build": "vite build",
    "seed": "npx prisma db seed",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "seed": "tsx scripts/init.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@supabase/supabase-js": "^2.112.2",
    "@vitejs/plugin-react": "^4.4.2",
    "autoprefixer": "^10.5.2",
    "bcryptjs": "^2.4.3",
    "convex": "^1.42.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.0-rc.1",
    "postcss": "^8.5.15",
    "prisma": "^6.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.3",
    "tsx": "^4.22.4",
    "uuid": "^11.1.0",
    "vite": "^7.1.1",
    "zod": "^3.24.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "rxjs": "^7.8.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
